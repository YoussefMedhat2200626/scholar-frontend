model User {
  id                  String                         @id @default(uuid())
  name                String?
  email               String                         @unique
  emailVerified       Boolean                        @default(false)
  role                UserRole?                      @default(student) 
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  

  //Better Auth Relations
  sessions            Session []
  accounts            Account[]

  // Relations
  profile             Profile?
  jobApplications     JobApplication[]  
  feedbacks           Feedback[]
  projectApplications GraduationProjectApplication[]


  //the Table will be named "users" in the postgresql 
  @@map("users")
}