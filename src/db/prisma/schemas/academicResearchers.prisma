model AcademicResearcher {
  id              Int      @id @default(autoincrement())
  firstName       String   
  lastName        String   
  institutionName String   
  department      String?
  affiliation     String?
  mainTopic       String?  
  subtopics       Json?
  scholarId       String?  
  linkedinUrl     String?  
  createdAt       DateTime @default(now()) 
  updatedAt       DateTime @updatedAt 

  @@map("academicResearchers")
}